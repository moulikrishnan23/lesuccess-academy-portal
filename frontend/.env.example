# Base URL of the Spring Boot API. No trailing slash.
#
# Read at BUILD time, not run time — Vite inlines it into the bundle. Note that
# .env.development is loaded only by `vite dev`; a production build reads
# .env.production or .env. If none of them set this, apiClient falls back to an
# empty baseURL and every /api/* call goes to the page's own origin.
#
# That empty fallback is correct when the API is served same-origin behind a
# reverse proxy. If it is not, this MUST be set at build time or the deployed
# app will 404 on every request. `vite preview` proxies /api to :8080 locally —
# Local dev: http://localhost:8080
# Production: https://lesuccess-academy-portal.onrender.com
VITE_API_BASE_URL=http://localhost:8080

# Dev-only escape hatch. When "true", the service layer resolves from
# src/mocks/ instead of the network, so the UI is workable before the
# backend endpoints exist. Leave unset in staging and production.
VITE_USE_MOCKS=false

# Website chatbot widget (bottom-right launcher on public pages). Read at BUILD
# time like the rest. Leave unset or false to ship without it: nothing renders
# and no /api/chat request is ever made. When true, the widget still hides
# itself if the backend answers 404 (backend chatbot.enabled=false), so the
# two flags can be switched on in either order.
VITE_CHATBOT_ENABLED=false
