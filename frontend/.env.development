VITE_API_BASE_URL=http://localhost:8080

# The real endpoints are live: /api/courses, /api/courses/{idOrSlug},
# /api/courses/{idOrSlug}/modules, /api/courses/{idOrSlug}/testimonials,
# /api/settings and /api/leads all exist and are served by the Spring backend.
#
# src/mocks/ is kept on purpose: setting this back to 'true' restores the
# fixture gateway and its ?mockState=slow|error|empty|emptyCatalog switches,
# which are the only way to reach the loading/error/empty branches on demand.
# See src/mocks/README.md.
VITE_USE_MOCKS=false
