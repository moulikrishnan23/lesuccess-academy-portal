# Template for local environment configuration.
# Copy to .env (git-ignored) and fill in real values, or export these in your shell.
# NEVER put real secrets in this file — it is committed.

# ---- Required in every non-test environment ----
# The application refuses to start without this. There is no fallback default:
# a committed default would let dev and staging run on a public secret.
# Must be at least 256 bits (32+ chars) for HS256.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# ---- Local dev database ----
# Required — application-dev.yml has no fallback for these either.
DB_USERNAME=
DB_PASSWORD=

# ---- Google Sheets sync ----
# Leave LESUCCESS_SHEETS_ENABLED unset (or false) to keep the integration off.
# Setting it to true activates GoogleSheetsConfig, which then REQUIRES both
# values below — an empty credentials path fails startup, not just the sync.
#
# Mind the names: only the enabled flag is prefixed. LESUCCESS_SHEETS_ENABLED
# reaches lesuccess.sheets.enabled through relaxed binding, but the other two
# are read as literal ${SHEETS_SPREADSHEET_ID} / ${SHEETS_CREDENTIALS_PATH}
# placeholders in application.yml, so a LESUCCESS_ prefix on them binds nothing.
LESUCCESS_SHEETS_ENABLED=
SHEETS_SPREADSHEET_ID=
SHEETS_CREDENTIALS_PATH=
   